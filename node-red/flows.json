        "type": "function",
        "z": "flowtab1",
        "name": "Validar e buscar aluno",
        "func": "if (!msg.payload || !msg.payload.ra) {\n    msg.statusCode = 400;\n    msg.payload = { erro: \"RA não informado\" };\n    return [null, msg];\n}\nmsg.ra_original = msg.payload.ra;\nvar ra = String(msg.payload.ra).replace(/'/g, \"\");\nmsg.topic = \"SELECT * FROM alunos WHERE ra = '\" + ra + \"'\";\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 80,
