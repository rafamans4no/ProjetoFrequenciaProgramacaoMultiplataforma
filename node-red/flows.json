    {
        "id": "n14",
        "type": "ui_template",
        "z": "flowtab1",
        "group": "group1",
        "name": "Tabela de Presenças",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n  .dash-wrapper {\n    font-family: 'Segoe UI', sans-serif;\n    background: #0d1117;\n    border-radius: 16px;\n    padding: 20px;\n  }\n\n  .stats-row {\n    display: flex;\n    gap: 14px;\n    margin-bottom: 20px;\n  }\n\n  .stat-card {\n    flex: 1;\n    background: linear-gradient(135deg, #161b22, #0d1117);\n    border: 1px solid #21262d;\n    border-radius: 12px;\n    padding: 16px 18px;\n  }\n\n  .stat-label {\n    color: #8b949e;\n    font-size: 12px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 8px;\n  }\n\n  .stat-value {\n    color: #ffffff;\n    font-size: 26px;\n    font-weight: 700;\n  }\n\n  .stat-value.green {\n    color: #4ade80;\n  }\n\n  .stat-icon {\n    float: right;\n    font-size: 20px;\n    opacity: 0.6;\n  }\n\n  .chart-card {\n    background: #161b22;\n    border: 1px solid #21262d;\n    border-radius: 12px;\n    padding: 18px 20px;\n    margin-bottom: 20px;\n  }\n\n  .chart-title {\n    color: #ffffff;\n    font-weight: 600;\n    font-size: 15px;\n    margin-bottom: 16px;\n  }\n\n  .bar-row {\n    display: flex;\n    align-items: center;\n    margin-bottom: 12px;\n  }\n\n  .bar-name {\n    width: 120px;\n    color: #c9d1d9;\n    font-size: 13px;\n    flex-shrink: 0;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .bar-track {\n    flex: 1;\n    background: #0d1117;\n    border-radius: 6px;\n    height: 22px;\n    overflow: hidden;\n    margin: 0 10px;\n  }\n\n  .bar-fill {\n    background: linear-gradient(90deg, #16a34a, #4ade80);\n    height: 100%;\n    border-radius: 6px;\n    transition: width 0.4s ease;\n  }\n\n  .bar-count {\n    color: #4ade80;\n    font-weight: 700;\n    font-size: 13px;\n    width: 24px;\n    text-align: right;\n    flex-shrink: 0;\n  }\n\n  .table-card {\n    background: #161b22;\n    border: 1px solid #21262d;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n\n  .table-header {\n    padding: 14px 20px;\n    border-bottom: 1px solid #21262d;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .table-header-title {\n    color: #ffffff;\n    font-weight: 600;\n    font-size: 15px;\n  }\n\n  .live-dot {\n    width: 8px;\n    height: 8px;\n    background: #4ade80;\n    border-radius: 50%;\n    display: inline-block;\n    margin-right: 8px;\n    animation: pulse 1.5s infinite;\n  }\n\n  @keyframes pulse {\n    0% {\n      opacity: 1;\n    }\n\n    50% {\n      opacity: 0.3;\n    }\n\n    100% {\n      opacity: 1;\n    }\n  }\n\n  .table-scroll {\n    max-height: 280px;\n    overflow-y: auto;\n    overflow-x: hidden;\n  }\n\n  .table-scroll::-webkit-scrollbar {\n    width: 8px;\n  }\n\n  .table-scroll::-webkit-scrollbar-track {\n    background: #0d1117;\n  }\n\n  .table-scroll::-webkit-scrollbar-thumb {\n    background: #30363d;\n    border-radius: 4px;\n  }\n\n  .table-scroll::-webkit-scrollbar-thumb:hover {\n    background: #4ade80;\n  }\n\n  table.dark-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  table.dark-table th {\n    background: #0d1117;\n    color: #8b949e;\n    text-align: left;\n    padding: 10px 20px;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    border-bottom: 1px solid #21262d;\n    position: sticky;\n    top: 0;\n  }\n\n  table.dark-table td {\n    padding: 12px 20px;\n    border-bottom: 1px solid #21262d;\n    font-size: 14px;\n    color: #c9d1d9;\n  }\n\n  table.dark-table tr:last-child td {\n    border-bottom: none;\n  }\n\n  table.dark-table tr:hover td {\n    background: #1c2128;\n  }\n\n  .ra-badge {\n    background: rgba(74, 222, 128, 0.15);\n    color: #4ade80;\n    padding: 3px 10px;\n    border-radius: 6px;\n    font-weight: 600;\n    font-size: 13px;\n  }\n</style>\n\n<div class=\"dash-wrapper\">\n  <div class=\"stats-row\">\n    <div class=\"stat-card\">\n      <span class=\"stat-icon\">📅</span>\n      <div class=\"stat-label\">Presenças Hoje</div>\n      <div class=\"stat-value green\">{{msg.stats.hoje}}</div>\n    </div>\n    <div class=\"stat-card\">\n      <span class=\"stat-icon\">📋</span>\n      <div class=\"stat-label\">Total de Registros</div>\n      <div class=\"stat-value\">{{msg.stats.total}}</div>\n    </div>\n    <div class=\"stat-card\">\n      <span class=\"stat-icon\">🎓</span>\n      <div class=\"stat-label\">Alunos Únicos</div>\n      <div class=\"stat-value\">{{msg.stats.unicos}}</div>\n    </div>\n  </div>\n\n  <div class=\"chart-card\">\n    <div class=\"chart-title\">📊 Frequência por Aluno</div>\n    <div ng-repeat=\"item in msg.freqArray\" class=\"bar-row\">\n      <div class=\"bar-name\">{{item.nome}}</div>\n      <div class=\"bar-track\">\n        <div class=\"bar-fill\" ng-style=\"{width: item.percent + '%'}\"></div>\n      </div>\n      <div class=\"bar-count\">{{item.count}}</div>\n    </div>\n  </div>\n\n  <div class=\"table-card\">\n    <div class=\"table-header\">\n      <span class=\"table-header-title\"><span class=\"live-dot\"></span>Presenças Registradas</span>\n    </div>\n    <div class=\"table-scroll\">\n      <table class=\"dark-table\">\n        <tr>\n          <th>RA</th>\n          <th>Nome</th>\n          <th>Data/Hora</th>\n        </tr>\n        <tr ng-repeat=\"item in msg.payload\">\n          <td><span class=\"ra-badge\">{{item.ra}}</span></td>\n          <td>{{item.nome}}</td>\n          <td>{{item.datahora | date:'dd/MM/yyyy HH:mm:ss'}}</td>\n        </tr>\n      </table>\n    </div>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1320,
        "y": 240,
        "wires": [
            []
        ]
