    {
        "id": "95af1adfb2e9028d",
        "type": "function",
        "z": "flowtab1",
        "name": "Montar Notificações Sucesso",
        "func": "msg.payload = {\n    title: \"✅ Presença Registrada\",\n    message: msg.payload.aluno + \" (RA \" + msg.payload.ra + \") às \" + new Date().toLocaleTimeString('pt-BR')\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1700,
        "y": 20,
