                "b3729735f8d77b12"
            ]
        ]
    },
    {
        "id": "74bc7416d2c405fd",
        "type": "function",
        "z": "flowtab1",
        "name": "Calcular Estátisticas",
        "func": "var rows = msg.payload;\n\nfunction toDateStr(d) {\n  var dateObj = (d instanceof Date) ? d : new Date(d);\n  return dateObj.toISOString().slice(0, 10);\n}\n\nvar hoje = new Date().toISOString().slice(0, 10);\n\nvar totalHoje = rows.filter(function(r) {\n    return r.datahora && toDateStr(r.datahora) === hoje;\n}).length;\n\nvar unicos = new Set(rows.map(function(r) { return r.ra; })).size;\n\nmsg.stats = {\n    hoje: totalHoje,\n    total: rows.length,\n    unicos: unicos\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 260,
        "wires": [
            [
                "6221fdfbf6789a70"
            ]
        ]
    },
    {
        "id": "6221fdfbf6789a70",
        "type": "function",
        "z": "flowtab1",
        "name": "Agrupar Frequência",
        "func": "var rows = msg.payload;\nvar contagem = {};\n\nrows.forEach(function(r) {\n    contagem[r.nome] = (contagem[r.nome] || 0) + 1;\n});\n\nvar maxCount = 0;\nvar freqArray = Object.keys(contagem).map(function(nome) {\n    var count = contagem[nome];\n    if (count > maxCount) maxCount = count;\n    return { nome: nome, count: count };\n});\n\nfreqArray.forEach(function(item) {\n    item.percent = maxCount > 0 ? Math.round((item.count / maxCount) * 100) : 5;\n});\n\nfreqArray.sort(function(a, b) { return b.count - a.count; });\n\nmsg.freqArray = freqArray;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 260,
        "wires": [
            [
                "n14"
            ]
        ]
    },
